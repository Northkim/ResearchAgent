# Credential-free development-only Docker Compose template. Every apparent
# identity/password below is a fictional demo placeholder, never a real secret.
# Change values locally if ports conflict; never reuse the placeholder password.
POSTGRES_USER=reagent
POSTGRES_PASSWORD=reagent-demo-only
POSTGRES_DB=reagent
REAGENT_POSTGRES_PORT=5432
REAGENT_BACKEND_PORT=8000
REAGENT_FRONTEND_PORT=3000

# These URLs are resolved inside the Compose network.
REAGENT_DATABASE_URL=postgresql+psycopg://reagent:reagent-demo-only@db:5432/reagent
REAGENT_TEST_DATABASE_URL=postgresql+psycopg://reagent:reagent-demo-only@db:5432/reagent_test
REAGENT_API_URL=http://backend:8000
REAGENT_ARTIFACT_ROOT=runtime_data/artifacts

# Paper discovery defaults to deterministic, network-free fake mode.
REAGENT_PAPER_SEARCH_PROVIDER=fake
# OpenAlex requires both explicit provider selection and this supervised opt-in.
REAGENT_OPENALEX_LIVE_ENABLED=false
# Required by ReAgent live mode for the free-credit preflight; never commit a real value.
REAGENT_OPENALEX_API_KEY=

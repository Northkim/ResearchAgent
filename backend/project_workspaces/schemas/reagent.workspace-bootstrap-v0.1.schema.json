{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reagent:runtime-schema:reagent.workspace-bootstrap:v0.1",
  "title": "reagent.workspace-bootstrap/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "workspace_schema_version", "project_id", "workspace_id",
    "cloud_origin_id", "project_api_path", "workspace_lifecycle",
    "bootstrap_manifest_revision", "desired_manifest_checksum", "desired_manifest",
    "workflow_capsules", "created_at", "descriptor_checksum"
  ],
  "properties": {
    "schema_version": {"const": "reagent.workspace-bootstrap/v0.1"},
    "workspace_schema_version": {"const": "reagent.project-workspace/v0.1"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^workspace-[0-9a-f]{32}$"},
    "cloud_origin_id": {"const": "reagent-local-api"},
    "project_api_path": {"type": "string", "pattern": "^/projects/project-[0-9a-f]{32}$"},
    "workspace_lifecycle": {"const": "ACTIVE"},
    "bootstrap_manifest_revision": {"type": "integer", "minimum": 1},
    "desired_manifest_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "desired_manifest": {"type": "object"},
    "workflow_capsules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_instance_id", "workflow_definition_id",
          "workflow_definition_version", "capsule_id", "capsule_version",
          "capsule_definition_checksum", "desired_state",
          "legacy_package_compatible", "package_schema_version",
          "package_template_id", "trust_classification", "legacy_package"
        ],
        "properties": {
          "workflow_instance_id": {"type": "string", "pattern": "^wfi-[0-9a-f]{32}$"},
          "workflow_definition_id": {"type": "string", "minLength": 2, "maxLength": 128},
          "workflow_definition_version": {"type": "string", "maxLength": 100},
          "capsule_id": {"type": "string", "pattern": "^capsule-[0-9a-f]{32}$"},
          "capsule_version": {"type": "string", "maxLength": 100},
          "capsule_definition_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "desired_state": {"enum": ["ACTIVE", "RETIRED"]},
          "legacy_package_compatible": {"type": "boolean"},
          "package_schema_version": {"type": "string", "maxLength": 100},
          "package_template_id": {"type": "string", "maxLength": 128},
          "trust_classification": {"const": "TRUSTED_BUILT_IN_UNSIGNED"},
          "legacy_package": {"type": ["object", "null"]}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time", "maxLength": 35},
    "descriptor_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

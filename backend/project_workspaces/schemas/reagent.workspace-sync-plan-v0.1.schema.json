{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reagent:runtime-schema:reagent.workspace-sync-plan:v0.1",
  "title": "reagent.workspace-sync-plan/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation_id", "project_id", "workspace_id", "base_manifest_revision", "target_manifest_revision", "target_manifest_checksum", "installed_lock_checksum", "plan_checksum", "state", "actions", "created_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "reagent.workspace-sync-plan/v0.1"},
    "installation_id": {"type": "string", "pattern": "^install-[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^workspace-[0-9a-f]{32}$"},
    "base_manifest_revision": {"type": "integer", "minimum": 0},
    "target_manifest_revision": {"type": "integer", "minimum": 1},
    "target_manifest_checksum": {"$ref": "#/$defs/checksum"},
    "installed_lock_checksum": {"anyOf": [{"$ref": "#/$defs/checksum"}, {"type": "null"}]},
    "plan_checksum": {"$ref": "#/$defs/checksum"},
    "state": {"enum": ["NO_CHANGE", "PLAN_CREATED"]},
    "actions": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 35},
    "expires_at": {"type": "string", "format": "date-time", "maxLength": 35}
  },
  "$defs": {"checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}

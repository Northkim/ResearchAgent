{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reagent:design-schema:reagent.capsule-installation-ack:v0.1",
  "title": "reagent.capsule-installation-ack/v0.1 (design only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "installation_id", "project_id", "workspace_id", "manifest_revision", "manifest_checksum", "plan_checksum", "installed_lock_checksum", "status", "installed_capsules", "installed_at"],
  "properties": {
    "schema_version": {"const": "reagent.capsule-installation-ack/v0.1"},
    "installation_id": {"type": "string", "pattern": "^install-[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^workspace-[0-9a-f]{32}$"},
    "manifest_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "manifest_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "installed_lock_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["INSTALLED", "ACK_PENDING", "ACKNOWLEDGED", "FAILED_SAFE"]},
    "installed_capsules": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["workflow_instance_id", "capsule_id", "capsule_version", "definition_checksum"], "properties": {"workflow_instance_id": {"type": "string", "pattern": "^wfi-[0-9a-f]{32}$"}, "capsule_id": {"type": "string", "pattern": "^capsule-[0-9a-f]{32}$"}, "capsule_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "definition_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "installed_at": {"type": "string", "format": "date-time", "maxLength": 35},
    "safe_failure_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "FAILED_SAFE"}}}, "then": {"required": ["safe_failure_code"]}, "else": {"not": {"required": ["safe_failure_code"]}}}
  ]
}

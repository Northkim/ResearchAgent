{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reagent:design-schema:reagent.external-resource-binding:v0.1",
  "title": "reagent.external-resource-binding/v0.1 (design only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_binding_id", "project_id", "provider", "resource_type", "locator", "immutable_revision", "workspace_relative_path", "access_mode", "sync_policy", "availability"],
  "properties": {
    "schema_version": {"const": "reagent.external-resource-binding/v0.1"},
    "resource_binding_id": {"type": "string", "pattern": "^resource-[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "provider": {"enum": ["GIT", "GITHUB", "HUGGING_FACE", "LOCAL_DIRECTORY", "EXTERNAL_STORE"]},
    "resource_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$"},
    "locator": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?![^:/?#]+://[^/@]*@)(?!.*[?&](?:token|key|signature|credential|password)=)(?!.*[\\u0000-\\u001f\\u007f]).+$"},
    "immutable_revision": {"type": "string", "minLength": 7, "maxLength": 200},
    "expected_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workspace_relative_path": {"type": "string", "pattern": "^resources/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]{1,1000}$"},
    "access_mode": {"enum": ["READ_ONLY", "OWNER_CONFIRMED_WRITE"]},
    "sync_policy": {"enum": ["MANUAL", "VERIFY_ONLY", "PULL_ON_EXPLICIT_SYNC"]},
    "availability": {"enum": ["UNRESOLVED", "AVAILABLE", "UNAVAILABLE", "GATED", "PRIVATE", "STALE", "RETIRED"]},
    "repo_type": {"enum": ["dataset", "model", "space"]},
    "allow_patterns": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "ignore_patterns": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "license_access_warning": {"type": "string", "maxLength": 2000}
  },
  "allOf": [
    {"if": {"properties": {"provider": {"const": "HUGGING_FACE"}}}, "then": {"required": ["repo_type"]}},
    {"if": {"properties": {"provider": {"enum": ["GIT", "GITHUB"]}}}, "then": {"properties": {"immutable_revision": {"pattern": "^[0-9a-f]{40,64}$"}}}}
  ]
}

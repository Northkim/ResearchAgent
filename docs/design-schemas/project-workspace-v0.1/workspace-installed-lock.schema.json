{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reagent:design-schema:reagent.workspace-installed-lock:v0.1",
  "title": "reagent.workspace-installed-lock/v0.1 (design only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "workspace_id", "manifest_revision", "manifest_checksum", "lock_checksum", "installed_capsules", "installed_skills", "materialized_artifacts", "resolved_resources", "written_at"],
  "properties": {
    "schema_version": {"const": "reagent.workspace-installed-lock/v0.1"},
    "project_id": {"type": "string", "pattern": "^project-[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^workspace-[0-9a-f]{32}$"},
    "manifest_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "manifest_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lock_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "installed_capsules": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/installedCapsule"}},
    "installed_skills": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/installedSkill"}},
    "materialized_artifacts": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/installedArtifact"}},
    "resolved_resources": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/resolvedResource"}},
    "written_at": {"type": "string", "format": "date-time", "maxLength": 35}
  },
  "$defs": {
    "installedCapsule": {"type": "object", "additionalProperties": false, "required": ["workflow_instance_id", "capsule_id", "capsule_version", "definition_checksum", "relative_path"], "properties": {"workflow_instance_id": {"type": "string", "pattern": "^wfi-[0-9a-f]{32}$"}, "capsule_id": {"type": "string", "pattern": "^capsule-[0-9a-f]{32}$"}, "capsule_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "definition_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "relative_path": {"type": "string", "pattern": "^capsules/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,1000}$"}}},
    "installedSkill": {"type": "object", "additionalProperties": false, "required": ["skill_id", "skill_version", "skill_checksum"], "properties": {"skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$"}, "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "skill_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "installedArtifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_checksum", "relative_path"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[0-9a-f]{32}$"}, "content_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "relative_path": {"type": "string", "pattern": "^artifacts/materialized/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,1000}$"}}},
    "resolvedResource": {"type": "object", "additionalProperties": false, "required": ["resource_binding_id", "immutable_revision", "availability"], "properties": {"resource_binding_id": {"type": "string", "pattern": "^resource-[0-9a-f]{32}$"}, "immutable_revision": {"type": "string", "minLength": 7, "maxLength": 200}, "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "GATED", "PRIVATE", "STALE"]}}}
  }
}
